const resourceCatalog = {
  mesa: {
    label: 'Mesa',
    unit: 'mesas',
    defaultTotal: 20,
  },
  silla: {
    label: 'Silla',
    unit: 'sillas',
    defaultTotal: 100,
  },
};

const inventory = {
  resources: [
    {
      id: 1,
      type: 'mesa',
      name: 'Mesa estándar',
      total: 20,
      available: 20,
      reserved: 0,
      borrowed: 0,
      returned: 0,
      status: 'active',
      createdAt: new Date().toISOString(),
    },
    {
      id: 2,
      type: 'silla',
      name: 'Silla estándar',
      total: 100,
      available: 100,
      reserved: 0,
      borrowed: 0,
      returned: 0,
      status: 'active',
      createdAt: new Date().toISOString(),
    },
  ],
  reservations: [],
  loans: [],
  returns: [],
  history: [],
};

function getStatusForResource(resource) {
  if (resource.total <= 0) return 'out_of_stock';
  if (resource.borrowed > 0) return 'in_loan';
  if (resource.reserved > 0) return 'reserved';
  if (resource.available <= 0) return 'unavailable';
  return 'active';
}

function syncResourceState(resourceId) {
  const resource = inventory.resources.find((item) => item.id === resourceId);
  if (!resource) return null;

  resource.status = getStatusForResource(resource);
  resource.available = Math.max(0, resource.total - resource.reserved - resource.borrowed);
  return resource;
}

function addHistory({ resourceId, user, action, quantity, previousState, newState, details }) {
  inventory.history.unshift({
    id: Date.now() + Math.random(),
    resourceId,
    user,
    action,
    quantity,
    previousState,
    newState,
    details,
    createdAt: new Date().toISOString(),
  });
}

module.exports = {
  inventory,
  resourceCatalog,
  syncResourceState,
  addHistory,
};

