CREATE EXTENSION IF NOT EXISTS pgcrypto;

CREATE TABLE roles (
    id SERIAL PRIMARY KEY,
    name VARCHAR(50) NOT NULL UNIQUE,
    description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE users (
    id SERIAL PRIMARY KEY,
    role_id INT NOT NULL REFERENCES roles(id),
    name VARCHAR(150) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    status VARCHAR(30) NOT NULL DEFAULT 'active',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE resources (
    id SERIAL PRIMARY KEY,
    type VARCHAR(30) NOT NULL CHECK (type IN ('mesa', 'silla')),
    name VARCHAR(150) NOT NULL,
    total_quantity INT NOT NULL CHECK (total_quantity >= 0),
    available_quantity INT NOT NULL CHECK (available_quantity >= 0),
    reserved_quantity INT NOT NULL CHECK (reserved_quantity >= 0),
    borrowed_quantity INT NOT NULL CHECK (borrowed_quantity >= 0),
    returned_quantity INT NOT NULL CHECK (returned_quantity >= 0),
    status VARCHAR(30) NOT NULL DEFAULT 'active',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE reservations (
    id SERIAL PRIMARY KEY,
    user_id INT NOT NULL REFERENCES users(id),
    reservation_code VARCHAR(50) NOT NULL UNIQUE,
    reservation_date DATE NOT NULL,
    start_time TIME,
    end_time TIME,
    status VARCHAR(30) NOT NULL CHECK (status IN ('pending', 'confirmed', 'cancelled', 'finalized')) DEFAULT 'pending',
    notes TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE reservation_items (
    id SERIAL PRIMARY KEY,
    reservation_id INT NOT NULL REFERENCES reservations(id) ON DELETE CASCADE,
    resource_id INT NOT NULL REFERENCES resources(id),
    quantity INT NOT NULL CHECK (quantity > 0),
    status VARCHAR(30) NOT NULL CHECK (status IN ('pending', 'confirmed', 'cancelled', 'fulfilled')) DEFAULT 'pending',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE loans (
    id SERIAL PRIMARY KEY,
    user_id INT NOT NULL REFERENCES users(id),
    responsible_person VARCHAR(150) NOT NULL,
    loan_date DATE NOT NULL,
    expected_return_date DATE NOT NULL,
    actual_return_date DATE,
    status VARCHAR(30) NOT NULL CHECK (status IN ('pending', 'active', 'partially_returned', 'returned', 'overdue')) DEFAULT 'pending',
    notes TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE loan_items (
    id SERIAL PRIMARY KEY,
    loan_id INT NOT NULL REFERENCES loans(id) ON DELETE CASCADE,
    resource_id INT NOT NULL REFERENCES resources(id),
    quantity_requested INT NOT NULL CHECK (quantity_requested > 0),
    quantity_loaned INT NOT NULL CHECK (quantity_loaned >= 0),
    quantity_returned INT NOT NULL CHECK (quantity_returned >= 0),
    quantity_pending INT NOT NULL CHECK (quantity_pending >= 0),
    status VARCHAR(30) NOT NULL CHECK (status IN ('pending', 'active', 'partially_returned', 'returned')) DEFAULT 'pending',
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE returns (
    id SERIAL PRIMARY KEY,
    loan_id INT NOT NULL REFERENCES loans(id),
    returned_by_user_id INT NOT NULL REFERENCES users(id),
    returned_date TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    notes TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE return_items (
    id SERIAL PRIMARY KEY,
    return_id INT NOT NULL REFERENCES returns(id) ON DELETE CASCADE,
    resource_id INT NOT NULL REFERENCES resources(id),
    quantity_returned INT NOT NULL CHECK (quantity_returned > 0),
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE inventory_movements (
    id SERIAL PRIMARY KEY,
    resource_id INT NOT NULL REFERENCES resources(id),
    movement_type VARCHAR(50) NOT NULL CHECK (movement_type IN ('reservation', 'cancelation', 'loan', 'return', 'partial_return', 'modification')),
    quantity INT NOT NULL CHECK (quantity >= 0),
    previous_available INT NOT NULL,
    new_available INT NOT NULL,
    previous_reserved INT NOT NULL,
    new_reserved INT NOT NULL,
    previous_borrowed INT NOT NULL,
    new_borrowed INT NOT NULL,
    previous_status VARCHAR(30),
    new_status VARCHAR(30),
    related_entity_type VARCHAR(50),
    related_entity_id INT,
    user_id INT REFERENCES users(id),
    notes TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE inventory_snapshot (
    id SERIAL PRIMARY KEY,
    resource_id INT NOT NULL REFERENCES resources(id) ON DELETE CASCADE,
    total_quantity INT NOT NULL,
    available_quantity INT NOT NULL,
    reserved_quantity INT NOT NULL,
    borrowed_quantity INT NOT NULL,
    returned_quantity INT NOT NULL,
    status VARCHAR(30) NOT NULL,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_resources_type ON resources(type);
CREATE INDEX idx_reservations_status ON reservations(status);
CREATE INDEX idx_loans_status ON loans(status);
CREATE INDEX idx_inventory_movements_resource_id ON inventory_movements(resource_id);
CREATE INDEX idx_inventory_snapshot_resource_id ON inventory_snapshot(resource_id);

