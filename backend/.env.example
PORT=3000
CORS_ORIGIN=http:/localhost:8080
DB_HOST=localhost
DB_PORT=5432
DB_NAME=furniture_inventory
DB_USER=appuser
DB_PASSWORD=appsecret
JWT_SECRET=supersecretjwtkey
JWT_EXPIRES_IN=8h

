CREATE VIEW v_inventory_summary AS
SELECT
    r.id,
    r.type,
    r.name,
    r.total_quantity,
    r.available_quantity,
    r.reserved_quantity,
    r.borrowed_quantity,
    r.returned_quantity,
    r.status,
    (r.total_quantity - r.reserved_quantity - r.borrowed_quantity) AS computed_available
FROM resources r;
